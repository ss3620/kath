#: includes/admin/settings/class-afwc-payouts-admin-settings.php:174
msgctxt "setting description tip"
msgid "Disabling this will not show it to affiliates in their account."
msgstr "Bunun devre dışı bırakılması, hesaplarındaki bağlı kuruluşlara gösterilmeyecektir."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:181
msgctxt "setting name"
msgid "Payout via PayPal"
msgstr "PayPal ile ödeme"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:312
msgctxt "placeholder for allowed coupon types for payouts"
msgid "Select the coupon type..."
msgstr "Kupon türünü seçin..."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:206
msgctxt "setting name"
msgid "Payout via Stripe"
msgstr "Stripe üzerinden ödeme"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:207
msgctxt "setting description"
msgid "Pay commissions via Stripe by allowing affiliates to link their Stripe accounts to your store"
msgstr "Satış ortaklarının Stripe hesaplarını mağazanıza bağlamalarına izin vererek komisyonları Stripe üzerinden ödeyin"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:212
msgctxt "setting description tip"
msgid "Disabling this will stop payouts through Stripe."
msgstr "Bunun devre dışı bırakılması Stripe üzerinden ödemeleri durduracaktır."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:216
msgctxt "setting name"
msgid "Stripe Publishable Key"
msgstr "Stripe Yayınlanabilir Anahtar"

#. translators: 1: Link to Stripe API keys dashboard 2: Stripe Connect documentation for testing with OAuth
#: includes/admin/settings/class-afwc-payouts-admin-settings.php:219
#, php-format
msgctxt "setting description"
msgid "To locate, go to <a href=\"%1$s\" target=\"_blank\">Stripe Dashboard > Developers > API keys ></a> <strong>Standard keys > Publishable key</strong> (more info: <a href=\"%2$s\" target=\"_blank\">%2$s</a>). Mandatory to add this for commission payouts to work."
msgstr "Bulmak için <a href=\"%1$s\" target=\"_blank\">Stripe Dashboard > Developers > API keys ></a> <strong>Standard keys > Publishable key</strong> (daha fazla bilgi: <a href=\"%2$s\" target=\"_blank\">%2$s</a>) adresine gidin. Komisyon ödemelerinin çalışması için bunu eklemek zorunludur."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:225
msgctxt "Placeholder for Stripe Publishable Key setting"
msgid "Values starting with \"pk_\""
msgstr "\"pk_\" ile başlayan değerler"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:235
msgctxt "setting name"
msgid "Stripe Secret Key"
msgstr "Stripe Gizli Anahtar"

#. translators: 1: Link to Stripe dashboard 2: Stripe Connect documentation for testing with OAuth
#: includes/admin/settings/class-afwc-payouts-admin-settings.php:238
#, php-format
msgctxt "setting description"
msgid "To locate, go to <a href=\"%1$s\" target=\"_blank\">Stripe Dashboard > Developers > API keys ></a> <strong>Standard keys > Secret key > Reveal live key</strong> (more info: <a href=\"%2$s\" target=\"_blank\">%2$s</a>). Mandatory to add this for commission payouts to work."
msgstr "Bulmak için <a href=\"%1$s\" target=\"_blank\">Stripe Dashboard > Developers > API keys ></a> <strong>Standard keys > Secret key > Reveal live key</strong> (daha fazla bilgi: <a href=\"%2$s\" target=\"_blank\">%2$s</a>). Komisyon ödemelerinin çalışması için bunu eklemek zorunludur."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:244
msgctxt "Placeholder for Stripe Secret Key setting"
msgid "Values starting with \"sk_\""
msgstr "\"sk_\" ile başlayan değerler"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:254
msgctxt "setting name"
msgid "Stripe Client ID"
msgstr "Stripe Müşteri Kimliği"

#. translators: 1: Link to Stripe dashboard 2: Stripe Connect documentation for testing with OAuth
#: includes/admin/settings/class-afwc-payouts-admin-settings.php:257
#, php-format
msgctxt "setting description"
msgid "To locate, go to <a href=\"%1$s\" target=\"_blank\">Stripe Dashboard > Settings > Connect > Onboarding options > OAuths ></a> <strong>Live mode client ID</strong> (more info: <a href=\"%2$s\" target=\"_blank\">%2$s</a>). Mandatory to add this for commission payouts to work."
msgstr "Bulmak için <a href=\"%1$s\" target=\"_blank\">Stripe Dashboard > Settings > Connect > Onboarding options > OAuths ></a> <strong>Live mode client ID</strong> (daha fazla bilgi: <a href=\"%2$s\" target=\"_blank\">%2$s</a>). Komisyon ödemelerinin çalışması için bunu eklemek zorunludur."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:263
msgctxt "Placeholder for Stripe Client ID setting"
msgid "Account ID - minimum 35 characters"
msgstr "Hesap Kimliği - en az 35 karakter"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:273
msgctxt "setting name"
msgid "Add redirect URIs"
msgstr "Yönlendirme URI'ları ekleyin"

#. translators: 1: Link to Stripe dashboard 2: current site's affiliate's my account endpoint for resources/profile tab
#: includes/admin/settings/class-afwc-payouts-admin-settings.php:276
#, php-format
msgctxt "setting description"
msgid "A <strong>Redirection URI is required</strong> when users connect their account to your site.<br><br>Go to <a href=\"%1$s\" target=\"_blank\">Stripe Dashboard > Settings > Connect > Onboarding options > OAuths ></a> <strong>Redirects</strong> section and add the following URl to redirect: <code>%2$s</code><br><br>Redirects URI can be defined on test and live mode, we would recommend to test both scenarios."
msgstr "Kullanıcılar hesaplarını sitenize bağladıklarında bir <strong>Yönlendirme URI'si gereklidir</strong>.<br><br> <a href=\"%1$s\" target=\"_blank\">Stripe Dashboard > Settings > Connect > Onboarding options > OAuths ></a> <strong>Redirects</strong> bölümüne gidin ve yönlendirmek için aşağıdaki URl'yi ekleyin: <code>%2$s</code><br><br>Yönlendirmeler URI test ve canlı modda tanımlanabilir, her iki senaryoyu da test etmenizi öneririz."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:284
msgctxt "setting description tip"
msgid "It is mandatory to set this in your Stripe account to process commission payouts. Otherwise, payouts won't be processed."
msgstr "Komisyon ödemelerini işlemek için bunu Stripe hesabınızda ayarlamanız zorunludur. Aksi takdirde ödemeler işleme alınmaz."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:326
msgctxt "setting name"
