msgstr "Otomatik ödemeler iştirakleri içerir"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:344
msgctxt "Admin setting placeholder to search affiliates to include them for automatic payouts"
msgid "Search affiliates by email, username or name"
msgstr "İştirakçileri e-posta, kullanıcı adı veya isme göre arayın"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:352
msgctxt "setting name"
msgid "Maximum commission to pay an affiliate"
msgstr "Bir satış ortağına ödenecek maksimum komisyon"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:353
