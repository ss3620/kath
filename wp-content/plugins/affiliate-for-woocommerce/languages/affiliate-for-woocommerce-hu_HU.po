msgstr "Kifizetés PayPal-on keresztül"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:312
msgctxt "placeholder for allowed coupon types for payouts"
msgid "Select the coupon type..."
msgstr "Válassza ki a kupon típusát..."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:206
msgctxt "setting name"
msgid "Payout via Stripe"
msgstr "Kifizetés Stripe-on keresztül"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:207
msgctxt "setting description"
msgid "Pay commissions via Stripe by allowing affiliates to link their Stripe accounts to your store"
msgstr "Fizessen jutalékokat Stripe-on keresztül, lehetővé téve a partnerek számára, hogy Stripe-fiókjukat összekapcsolják az áruházzal."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:212
