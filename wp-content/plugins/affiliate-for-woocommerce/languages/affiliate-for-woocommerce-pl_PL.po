msgctxt "Title for displaying the default commission plan link"
msgid "Default commission plan: %s"
msgstr "Domyślny plan prowizji: %s"

#: includes/admin/settings/class-afwc-commissions-admin-settings.php:93
msgctxt "Admin setting name for lifetime commissions"
msgid "Lifetime commissions"
msgstr "Prowizje na całe życie"

#: includes/admin/settings/class-afwc-commissions-admin-settings.php:94
msgctxt "Admin setting description for lifetime commissions"
msgid "Allow affiliates to receive lifetime commissions"
msgstr "Zezwól partnerom na otrzymywanie dożywotnich prowizji"

#: includes/admin/settings/class-afwc-commissions-admin-settings.php:98
msgctxt "Admin setting description tooltip for lifetime commissions"
msgid "Affiliates will receive commissions for every sale made by the same customer linked to this affiliate - without using referral link or coupon."
msgstr "Partnerzy otrzymają prowizje za każdą sprzedaż dokonaną przez tego samego klienta powiązanego z tym partnerem - bez użycia linku polecającego lub kuponu."

#: includes/admin/settings/class-afwc-commissions-admin-settings.php:101
msgctxt "Admin setting name for lifetime commissions excludes"
msgid "Lifetime commissions exclude affiliates"
msgstr "Prowizje lifetime nie obejmują partnerów"

#: includes/admin/settings/class-afwc-commissions-admin-settings.php:102
msgctxt "Admin setting description for affiliates to exclude for lifetime commissions"
msgid "Exclude the affiliates either by individual affiliates or affiliate tags to not give them lifetime commissions."
msgstr "Wyklucz partnerów indywidualnie lub za pomocą tagów partnerskich, aby nie przyznawać im prowizji lifetime."

#: includes/admin/settings/class-afwc-commissions-admin-settings.php:106
msgctxt "Admin setting placeholder for lifetime commissions excludes"
msgid "Search by affiliates or affiliate tags"
msgstr "Szukaj według partnerów lub tagów partnerskich"

#: includes/admin/settings/class-afwc-commissions-admin-settings.php:155
