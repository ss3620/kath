msgstr "Approva automaticamente tutte le richieste tramite il Modulo di registrazione affiliati: non serve alcuna revisione manuale"

#: includes/admin/settings/class-afwc-general-admin-settings.php:112
msgctxt "Description for Approval method setting tooltip"
msgid "Disabling this will require you to review and approve affiliates yourself. They won't become affiliates until you approve."
msgstr "Se disattivi questa opzione, dovrai esaminare e approvare tu stesso gli affiliati. Non diventeranno affiliati finché non li avrai approvati."

