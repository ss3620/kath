msgstr "Consenti agli affiliati di inserire il proprio indirizzo e-mail PayPal dalla sezione Il mio account > Affiliati > Profilo per ricevere i pagamenti tramite PayPal"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:174
msgctxt "setting description tip"
msgid "Disabling this will not show it to affiliates in their account."
msgstr "Se disattivi questa opzione, non verrà mostrata agli affiliati nel loro account."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:181
msgctxt "setting name"
msgid "Payout via PayPal"
msgstr "Pagamento tramite PayPal"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:200
msgctxt "Stripe payout setting section title"
msgid "Stripe"
msgstr "Stripe"

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:203
msgctxt "Stripe payout setting description"
msgid "Set up Stripe as a payout method to send affiliate commissions."
msgstr "Configura Stripe come metodo di pagamento per inviare le commissioni agli affiliati."

#: includes/admin/settings/class-afwc-payouts-admin-settings.php:206
msgctxt "setting name"
