#. Plugin Name of the plugin
msgid "WowShipping – Weight Based Flexible Table Rate Shipping for WooCommerce"
msgstr "WowShipping – Elastyczne wysyłki oparte na wadze dla WooCommerce"

#. Description of the plugin
msgid "WowShipping allows store owners to define flexible shipping rates based on conditions like weight, destination, price, item count etc."
msgstr "WowShipping pozwala właścicielom sklepów definiować elastyczne stawki wysyłki w oparciu o warunki takie jak waga, miejsce docelowe, cena, liczba przedmiotów itp."

#. Author of the plugin
msgid "WPXPO"
msgstr "WPXPO"

#. Author URI of the plugin
msgid "https://www.wpxpo.com/about"
msgstr "https://www.wpxpo.com/about"

